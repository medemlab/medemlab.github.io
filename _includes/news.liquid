{% if site.news != blank %}
  {% assign news = site.news | sort: 'date' | reverse %}
  <div class="news">
    <table class="table table-sm table-borderless">
      {% comment %} 1~3번째 뉴스: 항상 노출 {% endcomment %}
      {% for item in news limit: 3 %}
        <tr>
          <th scope="row" class="news-date-cell">{{ item.date | date: "%Y %b" }}</th>
          <td class="news-content-cell">
            {% if item.inline %}{{ item.content | remove: '<p>' | remove: '</p>' }}
            {% else %}<a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>{% endif %}
          </td>
        </tr>
      {% endfor %}
    </table>

    {% comment %} 4~10번째 뉴스: 접어서 숨김 {% endcomment %}
    {% if news.size > 3 %}
    <details class="news-details">
      <summary class="news-more-btn">More news...</summary>
      <table class="table table-sm table-borderless">
        {% for item in news offset: 3 limit: 7 %}
          <tr>
            <th scope="row" class="news-date-cell">{{ item.date | date: "%Y %b" }}</th>
            <td class="news-content-cell">
              {% if item.inline %}{{ item.content | remove: '<p>' | remove: '</p>' }}
              {% else %}<a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>{% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </details>
    {% endif %}
  </div>
{% else %}
  <p>No news so far...</p>
{% endif %}